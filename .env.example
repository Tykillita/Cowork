# Copia este archivo como .env.local y usa la configuración web de tu Firebase.
# Son identificadores públicos; nunca pongas credenciales de administrador aquí.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
# Use the same hostname that serves this app (for example, cowork.web.app) for redirect sign-in.
VITE_FIREBASE_AUTH_DOMAIN=

# Solo para desarrollo con emuladores.
VITE_USE_FIREBASE_EMULATORS=
VITE_FIREBASE_EMULATOR_HOST=
